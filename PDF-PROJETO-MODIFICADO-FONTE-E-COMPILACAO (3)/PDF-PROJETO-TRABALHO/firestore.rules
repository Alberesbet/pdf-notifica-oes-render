rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    match /phone_index/{phoneKey} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow create: if request.auth != null
          && request.auth.uid in participants()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid in participants();

        allow read: if request.auth != null && request.auth.uid in participants();

        allow update: if request.auth != null
          && request.auth.uid in participants()
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.recipientUid == resource.data.recipientUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'readAt'])
            || (resource.data.senderUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachmentPending']))
          );

        allow delete: if request.auth != null && request.auth.uid in participants();

        match /chunks/{chunkId} {
          allow read: if request.auth != null && request.auth.uid in participants();
          allow create: if request.auth != null
            && request.auth.uid in participants()
            && request.resource.data.senderUid == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data.senderUid == request.auth.uid;
          allow delete: if request.auth != null && request.auth.uid in participants();
        }
      }
    }

    match /calls/{callId} {
      allow create: if request.auth != null && request.resource.data.callerUid == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);

      match /callerCandidates/{candidateId} {
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
      }

      match /calleeCandidates/{candidateId} {
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
      }
    }

    // Contagem agregada de instalações: o total é compartilhado, sem expor nomes/telefones.
    match /download_stats/{statsId} {
      allow read: if request.auth != null && statsId == "global";
      allow create: if request.auth != null
        && statsId == "global"
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count == 1
        && !exists(/databases/$(database)/documents/download_installations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/download_installations/$(request.auth.uid)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && statsId == "global"
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count == resource.data.count + 1
        && !exists(/databases/$(database)/documents/download_installations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/download_installations/$(request.auth.uid)).data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Cada usuário autenticado só pode criar e consultar seu próprio marcador anônimo.
    match /download_installations/{uid} {
      allow create: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/download_installations/$(request.auth.uid));
      allow read: if request.auth != null && uid == request.auth.uid;
      allow update, delete: if false;
    }

    // URL pública de download configurada pelo administrador no Firestore.
    match /app_config/{configId} {
      allow read: if request.auth != null && configId == "download";
      allow write: if false;
    }
  }
}
